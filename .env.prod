# Docker Compose ports
FRONTEND_PORT=5173
BACKEND_PORT=8000
POSTGRES_PORT=5433

# Database bootstrap
POSTGRES_USER=gnucash
POSTGRES_PASSWORD=gnucash
POSTGRES_DB=gnucash_web
DATABASE_URL=postgresql+psycopg://gnucash:gnucash@db:5432/gnucash_web

# Frontend build-time API endpoint
VITE_API_BASE_URL=https://cash.igeos.com.br/api

# Backend app settings
CORS_ORIGINS=https://cash.igeos.com.br
AUTH_REQUIRED=true
AUTH_JWT_SECRET=change-this-secret-in-production
AUTH_ACCESS_TOKEN_TTL_MINUTES=30
AUTH_REFRESH_TOKEN_TTL_MINUTES=10080
AUTH_PASSWORD_ITERATIONS=210000
SEED_ON_STARTUP=false
