### Create transaction with two balanced splits
POST https://api.example.com/transactions
Content-Type: application/json

{
  "currency_guid": "0e8db798-0f67-4d0f-a89f-bef7fefad9b1",
  "num": "0001",
  "description": "Initial balance",
  "splits": [
    {
      "account_guid": "2dfd7a53-8899-4dfa-8b14-1749d5cb84d1",
      "memo": "Debit cash",
      "action": "",
      "reconcile_state": "n",
      "value_num": 10000,
      "value_denom": 100,
      "quantity_num": 10000,
      "quantity_denom": 100
    },
    {
      "account_guid": "7b8f5571-79bf-4b3f-bc40-8e62f7ca8f29",
      "memo": "Credit equity",
      "action": "",
      "reconcile_state": "n",
      "value_num": -10000,
      "value_denom": 100,
      "quantity_num": -10000,
      "quantity_denom": 100
    }
  ]
}

